{
  "manifest_version": 3,
  "name": "Handsfree - Voice Controller & Dictation",
  "version": "1.2.0",
  "description": "Voice-controlled web navigation, voice typing, accessible webpage reading, and Sarvam AI integration.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Handsfree Voice Controller",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "permission.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
